# Copy to .env and adjust. Never commit .env.

APP_NAME="UMP Events"
# development shows demo-login hints; production hides them
APP_ENV=development
# true shows stack traces on error pages — keep false in production
APP_DEBUG=false
# Leave empty to auto-detect the base URL
APP_URL=
APP_TIMEZONE=Africa/Johannesburg

# XAMPP defaults: user root, empty password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ump_event_booking
DB_USERNAME=root
DB_PASSWORD=
